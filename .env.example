# Copy to `.env` (git-ignored) beside compose.yaml and fill in. The key
# reaches the container only through compose's env_file at run time.
DEEPSEEK_API_KEY=

# The submit gate's exemption: visiting /unlock/<token> once per device mints
# the operator's bypass cookie; rotating the value revokes every cookie.
# Leave empty to have no exemption door at all.
STEAMLENS_ADMIN_TOKEN=

# Optional spend-breaker dials — unset means the ServeConfig defaults
# (5 fresh analyses per UTC day, $1 settled-spend backstop).
# STEAMLENS_DAILY_JOB_LIMIT=5
# STEAMLENS_DAILY_SPEND_BACKSTOP_USD=1.0
