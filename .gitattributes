# Byte-pinned eval artifacts. Their sha256 digests are journaled inside eval-run
# config hashes and regenerated by the CI eval gate on Linux, so their on-disk
# bytes must be identical on every platform — no CRLF conversion, ever.
eval/gold/gold.jsonl text eol=lf
eval/agreement/sample.jsonl text eol=lf
eval/ci/** text eol=lf
src/steamlens/ontology/*.toml text eol=lf
